# Dynova Cloud - Hostinger Node.js Web App Environment Variables
# Node server port (Hostinger provides PORT dynamically; fallback is 3000)
PORT=3000

# Hostinger SMTP Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@dynova.cloud
SMTP_PASS=your_hostinger_mailbox_password_here

# Contact Email Routing
CONTACT_TO=info@dynova.cloud
CONTACT_FROM=info@dynova.cloud
